#property strict
#include <Trade/Trade.mqh>
#include <Calendar\Calendar.mqh>
CTrade trade;

//================ INPUTS =================//
input double RiskPercent = 1.0;
input int MaxOpenTrades = 3;

input int StopLossPips = 100;
input int TakeProfitPips = 300;

input int BreakEvenPips = 30;
input int PartialClosePips = 80;
input double PartialClosePercent = 50;

input int ATRPeriod = 14;
input double ATRMultiplier = 1.5;

input int FastMAPeriod = 20;
input int SlowMAPeriod = 50;
input int ADXPeriod = 14;
input double ADXMin = 25;

input int TradeStartHour = 7;
input int TradeEndHour = 22;
input int NewsBlockMinutes = 30;

input double EquityTrailPct = 2.0;

//================ GLOBALS =================//
datetime lastH1 = 0;
double equityPeak;

//================ UTILITIES =================//
double Pip(){ return (_Digits==3||_Digits==5)?_Point*10:_Point; }

bool NewH1()
{
   datetime t=iTime(_Symbol,PERIOD_H1,0);
   if(t!=lastH1){ lastH1=t; return true; }
   return false;
}

bool SessionOK()
{
   int h=TimeHour(TimeCurrent());
   return (h>=TradeStartHour && h<=TradeEndHour);
}

bool NewsOK()
{
   MqlCalendarValue v[];
   if(CalendarValueHistory(v,TimeCurrent()-NewsBlockMinutes*60,TimeCurrent()+NewsBlockMinutes*60))
      for(int i=0;i<ArraySize(v);i++)
         if(v[i].importance==CALENDAR_IMPORTANCE_HIGH) return false;
   return true;
}

bool Trending()
{
   return iADX(_Symbol,PERIOD_H1,ADXPeriod,PRICE_CLOSE,MODE_MAIN,0)>=ADXMin;
}

bool DailyBull()
{
   return iMA(_Symbol,PERIOD_D1,FastMAPeriod,0,MODE_EMA,PRICE_CLOSE,0)>
          iMA(_Symbol,PERIOD_D1,SlowMAPeriod,0,MODE_EMA,PRICE_CLOSE,0);
}

int TradesCount()
{
   int c=0;
   for(int i=0;i<PositionsTotal();i++)
      if(PositionGetSymbol(i)==_Symbol) c++;
   return c;
}

double CalcLot()
{
   double risk=AccountInfoDouble(ACCOUNT_BALANCE)*RiskPercent/100.0;
   double tick=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE);
   return NormalizeDouble(risk/(StopLossPips*tick),2);
}

//================ SMART MONEY =================//

bool BullBOS(){ return High[1]>High[3]; }
bool BearBOS(){ return Low[1]<Low[3]; }

bool BullOB(){ return Close[2]<Open[2] && High[1]>High[2]; }
bool BearOB(){ return Close[2]>Open[2] && Low[1]<Low[2]; }

bool BullFVG(){ return Low[0]>High[2]; }
bool BearFVG(){ return High[0]<Low[2]; }

bool InGolden(bool bull)
{
   double hi=iHigh(_Symbol,PERIOD_H1,10);
   double lo=iLow(_Symbol,PERIOD_H1,10);
   double f50=lo+(hi-lo)*0.5;
   double f618=lo+(hi-lo)*0.618;
   return bull?(Bid>=f50&&Bid<=f618):(Ask<=f618&&Ask>=f50);
}

bool TrendRetest(bool bull)
{
   double ema=iMA(_Symbol,PERIOD_H1,50,0,MODE_EMA,PRICE_CLOSE,0);
   return bull?(Low[0]<=ema && Close[0]>ema):(High[0]>=ema && Close[0]<ema);
}

//================ MANAGEMENT =================//
void ManageTrades()
{
   double atr=iATR(_Symbol,PERIOD_H1,ATRPeriod,0);
   double pip=Pip();

   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      if(!PositionSelectByIndex(i))continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol)continue;

      ulong t=PositionGetInteger(POSITION_TICKET);
      int type=PositionGetInteger(POSITION_TYPE);
      double open=PositionGetDouble(POSITION_PRICE_OPEN);
      double sl=PositionGetDouble(POSITION_SL);
      double vol=PositionGetDouble(POSITION_VOLUME);

      double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
      double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);

      if(type==POSITION_TYPE_BUY)
      {
         if(bid-open>=BreakEvenPips*pip && sl<open)
            trade.PositionModify(t,open,0);
         if(bid-open>=PartialClosePips*pip)
            trade.PositionClosePartial(t,vol*PartialClosePercent/100.0);
         trade.PositionModify(t,bid-atr*ATRMultiplier,0);
      }

      if(type==POSITION_TYPE_SELL)
      {
         if(open-ask>=BreakEvenPips*pip && (sl==0||sl>open))
            trade.PositionModify(t,open,0);
         if(open-ask>=PartialClosePips*pip)
            trade.PositionClosePartial(t,vol*PartialClosePercent/100.0);
         trade.PositionModify(t,ask+atr*ATRMultiplier,0);
      }
   }
}

void EquityTrail()
{
   double eq=AccountInfoDouble(ACCOUNT_EQUITY);
   if(eq>equityPeak) equityPeak=eq;
   if((equityPeak-eq)/equityPeak*100.0>=EquityTrailPct)
      for(int i=PositionsTotal()-1;i>=0;i--)
         trade.PositionClose(PositionGetTicket(i));
}

//================ MAIN =================//
void OnInit(){ equityPeak=AccountInfoDouble(ACCOUNT_EQUITY); }

void OnTick()
{
   ManageTrades();
   EquityTrail();

   if(!NewH1())return;
   if(!SessionOK()||!NewsOK()||!Trending())return;
   if(TradesCount()>=MaxOpenTrades)return;

   double lot=CalcLot(), pip=Pip();

   // BUY
   if(DailyBull() && BullBOS() && TrendRetest(true) &&
      (BullOB()||BullFVG()) && InGolden(true))
      trade.Buy(lot,_Symbol,Ask,Ask-StopLossPips*pip,Ask+TakeProfitPips*pip);

   // SELL
   if(!DailyBull() && BearBOS() && TrendRetest(false) &&
      (BearOB()||BearFVG()) && InGolden(false))
      trade.Sell(lot,_Symbol,Bid,Bid+StopLossPips*pip,Bid-TakeProfitPips*pip);
}